# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file — it is already in .gitignore.

# ---- App ----
ENV=development                      # development | production
APP_NAME=Store 8 Supplement Shop API
# Comma-separated list of origins allowed to call this API.
# Add your deployed website URL here once you have a domain.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Firebase ----
# Option A (local dev): path to the service account JSON file you downloaded from
#   Firebase Console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT_FILE=./secrets/firebase-service-account.json
# Option B (hosting providers with no persistent disk, e.g. Vercel/Render/Railway env vars):
# base64 the same JSON file (`base64 -w0 firebase-service-account.json`) and paste it here.
# If this is set, it takes priority over FIREBASE_SERVICE_ACCOUNT_FILE.
FIREBASE_SERVICE_ACCOUNT_B64=
# Exact bucket name from Firebase Console -> Storage -> Files (shown at the top after "gs://"),
# e.g. store8-tech.firebasestorage.app. Storage needs the Blaze (pay-as-you-go) plan enabled
# first — see SETUP.md. Product images (uploaded via the admin app) are stored here.
FIREBASE_STORAGE_BUCKET=

# ---- Security ----
# Random long string used to sign short-lived upload tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Requests/minute allowed per IP on the public order endpoint (abuse protection).
ORDER_RATE_LIMIT=6/minute
